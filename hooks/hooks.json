{
  "description": "Bootstrap the shared folder and request the original skill. No ordinary-work gates or scheduler.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
